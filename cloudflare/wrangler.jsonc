// Kakuki Worker 配置：API + 前端静态资产同源部署
// 部署后绑定 kakuki.top（wrangler deploy 时用 --routes 或在 dashboard 配置 Custom Domain）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kakuki",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 前端构建产物：assets-first，未命中静态文件的请求进入 Worker（API 路由），
  // 其余路径 SPA fallback 返回 index.html
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakuki-db",
      "database_id": "d0ba1222-e4b1-4f59-8c80-c618f89051e1"
    }
  ],

  // 站内音频库（2026-09-13 三定）：
  //   DB       D1 —— 曲目元数据（media_tracks 表，强一致，上传后列表即时刷新）
  //   MEDIA_R2 R2 —— 音频二进制（audio/<id>，单文件 ≤ 60 MiB），
  //              库总容量业务层写死 ≤ 10 GiB（R2 免费额度，超限上传 413）。
  // 播放走 /api/v1/media/stream/<id>/ 同源流接口，支持 Range（R2 原生 range get）。
  // 旧 KV 方案（MEDIA 绑定）已废弃，命名空间保留在账号中未删除。
  "r2_buckets": [
    {
      "binding": "MEDIA_R2",
      "bucket_name": "kakuki-media"
    }
  ],

  "vars": {
    "JWT_ISSUER": "kakuki",
    // 本地 dev 的默认密钥；生产用 `wrangler secret put JWT_SECRET` 覆盖
    "JWT_SECRET_DEV": "kakuki-dev-secret-do-not-use-in-prod",
    // 仪表盘「站点流量」区块：zone = kakuki.top（token 走 `wrangler secret put CF_API_TOKEN`，不落仓库）
    "CF_ZONE_ID": "5df5f46272878adf615530b6864627cd"
  },

  "observability": {
    "enabled": true
  },

  // 自定义域：自动创建 DNS 记录与边缘证书（zone = kakuki.top，已托管在 Cloudflare）
  "routes": [
    { "pattern": "kakuki.top", "custom_domain": true },
    { "pattern": "www.kakuki.top", "custom_domain": true }
  ]
}
